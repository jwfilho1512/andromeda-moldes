{
  "name": "@cad-textil/modelagem-2d",
  "productName": "Andromeda Moldes",
  "description": "Andromeda Moldes — modelagem 2D, graduação, risco e encaixe para confecção",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "web": "vite",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "icons": "electron scripts/make-icons.mjs",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --publish always"
  },
  "devDependencies": {
    "@cad-textil/bases": "*",
    "@cad-textil/core": "*",
    "@tabler/icons-react": "^3.36.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^7.3.7"
  },
  "author": {
    "name": "Andromeda Moldes"
  },
  "license": "MIT"
}
